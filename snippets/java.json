{
  "Java Eclipe Settings Project": {
    "desc": "<project-root>/.settings/org.eclipse.jdt.core.prefs",
    "prefix": "eclipse-prefs",
    "body": [
      "eclipse.preferences.version=1",
      "org.eclipse.jdt.core.compiler.source=${1:21}",
      "org.eclipse.jdt.core.compiler.compliance=${1:21}",
      "org.eclipse.jdt.core.compiler.codegen.targetPlatform=${1:21}",
      ""
    ]
  },
  "Java Basic Project": {
    "desc": "Java base .project on the project root",
    "prefix": "project-base",
    "body": [
      "<?xml version=\"1.0\" encoding=\"UTF-8\"?>",
      "<projectDescription>",
      "  <name>${1:AppName}</name>",
      "  <comment></comment>$",
      "  <projects></projects>",
      "  <buildSpec>",
      "    <buildCommand>",
      "      <name>org.eclipse.jdt.core.javabuilder</name>",
      "      <arguments></arguments>",
      "    </buildCommand>",
      "  </buildSpec>",
      "  <natures>",
      "    <nature>org.eclipse.jdt.core.javanature</nature>",
      "  </natures>",
      "</projectDescription>"
    ]
  },

  "Java Basic Classpath": {
    "desc": "Java base .classpath on the project root",
    "prefix": "xml-base",
    "body": [
      "<?xml version=\"1.0\" encoding=\"UTF-8\"?>",
      "<classpath>",
      "    <!-- Map your custom source directory (e.g., \"src\") -->",
      "    <classpathentry kind=\"src\" path=\"src/main/java\" output=\"target/classes/main\"/>",
      "",
      "    <!-- Map the default Java System Library (JRE) -->",
      "    <classpathentry kind=\"con\" path=\"org.eclipse.jdt.launching.JRE_CONTAINER\"/>",
      "    <classpathentry kind=\"output\" path=\"bin/default\"/>",
      "</classpath>"
    ]
  }
}
